<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PesquisaProblemasActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPesquisaE3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PESQUISA ELEITORAL"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/imgVLogoExame3"
                app:layout_constraintStart_toStartOf="@+id/imgVLogoExame3"
                app:layout_constraintTop_toBottomOf="@+id/imgVLogoExame3"
                tools:textStyle="bold" />

            <ImageView
                android:id="@+id/imgVLogoExame3"
                android:layout_width="150dp"
                android:layout_height="70dp"
                android:layout_marginTop="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btVoltar"
                app:srcCompat="@drawable/logo_exame_icon" />

            <Button
                android:id="@+id/btVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="Voltar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvImpLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="3. IMPACTO LOCAL"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/tvPesquisaE3"
                app:layout_constraintStart_toStartOf="@+id/tvPesquisaE3"
                app:layout_constraintTop_toBottomOf="@+id/tvPesquisaE3"
                tools:textStyle="bold" />

            <TextView
                android:id="@+id/tvPerguntaEsp2"
                android:layout_width="328dp"
                android:layout_height="44dp"
                android:layout_marginTop="80dp"
                android:text="Dentre as opções abaixo, selecione os aspectos que mais afetam a sua região."
                app:layout_constraintEnd_toEndOf="@+id/imgVLogoExame3"
                app:layout_constraintStart_toStartOf="@+id/imgVLogoExame3"
                app:layout_constraintTop_toBottomOf="@+id/tvImpLocal" />

            <CheckBox
                android:id="@+id/cbP1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Saúde Pública"
                app:layout_constraintStart_toStartOf="@+id/tvPerguntaEsp2"
                app:layout_constraintTop_toBottomOf="@+id/tvPerguntaEsp2" />

            <CheckBox
                android:id="@+id/cbP2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Segurança Pública"
                app:layout_constraintStart_toStartOf="@+id/cbP1"
                app:layout_constraintTop_toBottomOf="@+id/cbP1" />

            <CheckBox
                android:id="@+id/cbP3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Educação"
                app:layout_constraintStart_toStartOf="@+id/cbP2"
                app:layout_constraintTop_toBottomOf="@+id/cbP2" />

            <CheckBox
                android:id="@+id/cbP4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Emprego e Renda"
                app:layout_constraintStart_toStartOf="@+id/cbP3"
                app:layout_constraintTop_toBottomOf="@+id/cbP3" />

            <CheckBox
                android:id="@+id/cbP5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Infraestrutura Urbana"
                app:layout_constraintStart_toStartOf="@+id/cbP4"
                app:layout_constraintTop_toBottomOf="@+id/cbP4" />

            <CheckBox
                android:id="@+id/cbP6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Saneamento Básico"
                app:layout_constraintStart_toStartOf="@+id/cbP5"
                app:layout_constraintTop_toBottomOf="@+id/cbP5" />

            <CheckBox
                android:id="@+id/cbP7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Transporte Público"
                app:layout_constraintStart_toStartOf="@+id/cbP6"
                app:layout_constraintTop_toBottomOf="@+id/cbP6" />

            <CheckBox
                android:id="@+id/cbP8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Limpeza Urbana"
                app:layout_constraintStart_toStartOf="@+id/cbP9"
                app:layout_constraintTop_toBottomOf="@+id/cbP9" />

            <CheckBox
                android:id="@+id/cbP9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Habitação"
                app:layout_constraintStart_toStartOf="@+id/cbP7"
                app:layout_constraintTop_toBottomOf="@+id/cbP7" />

            <CheckBox
                android:id="@+id/cbP10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Outros"
                app:layout_constraintStart_toStartOf="@+id/cbP8"
                app:layout_constraintTop_toBottomOf="@+id/cbP8" />

            <Button
                android:id="@+id/btEnviar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="31dp"
                android:layout_marginBottom="50dp"
                android:text="Enviar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/imgVLogoExame3"
                app:layout_constraintStart_toStartOf="@+id/imgVLogoExame3"
                app:layout_constraintTop_toBottomOf="@+id/cbP10" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>