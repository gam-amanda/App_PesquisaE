<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ResultadosActivity">

    <TextView
        android:id="@+id/tvTituloResultados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Resultados da pesquisa"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/imgVLogoExame"
        app:layout_constraintStart_toStartOf="@+id/imgVLogoExame"
        app:layout_constraintTop_toBottomOf="@+id/imgVLogoExame"
        tools:textStyle="bold" />

    <ImageView
        android:id="@+id/imgVLogoExame"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btVoltar"
        app:srcCompat="@drawable/logo_exame_icon" />

    <Button
        android:id="@+id/btVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvQtdPessoas"
        android:layout_width="60dp"
        android:layout_height="29dp"
        android:layout_marginTop="10dp"
        android:text="0"
        android:textAlignment="center"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/tvTituloMenu"
        app:layout_constraintHorizontal_bias="0.516"
        app:layout_constraintStart_toStartOf="@+id/tvTituloMenu"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloMenu"
        tools:textAlignment="center"
        tools:textStyle="bold" />

    <TextView
        android:id="@+id/tvTituloMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Total eleitores"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/imgVLogoExame"
        app:layout_constraintStart_toStartOf="@+id/imgVLogoExame"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloResultados"
        tools:textStyle="bold" />

    <!-- Gráfico Pizza -->
    <!-- Parte rolável: legenda e pizza -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvQtdPessoas">

        <LinearLayout
            android:id="@+id/llConteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quant. de votos para cada candidato:"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llLegenda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvSemDados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ainda não há entrevistas registradas."
                android:visibility="gone" />

            <com.example.app_pesquisae.PieChartView
                android:id="@+id/pieVotos"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>